<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://apache.org"
         xmlns:xsi="http://w3.org"
         xsi:schemaLocation="http://apache.org http://apache.org">
<modelVersion>4.0.0</modelVersion>

<!-- Основные метаданные проекта (могут немного отличаться в вашей IDE) -->
<groupId>kolkova_tan</groupId>
<artifactId>java-pro-hw30-jpa-hibernate</artifactId>
<version>1.0-SNAPSHOT</version>

<properties>
    <!-- Настройка компиляции под современную версию Java (из вашего лога — Java 25) -->
    <maven.compiler.source>25</maven.compiler.source>
    <maven.compiler.target>25</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
</properties>

<dependencies>
    <!-- 1. JDBC Драйвер для подключения к базе данных PostgreSQL -->
    <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>42.7.3</version>
    </dependency>

    <!-- 2. Hibernate Core — реализация JPA для работы с сущностями Student и Homework -->
    <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-core</artifactId>
        <version>6.5.2.Final</version>
    </dependency>

    <!-- 3. Jakarta Persistence API (JPA) для работы с аннотациями @Entity, @Table -->
    <dependency>
        <groupId>jakarta.persistence</groupId>
        <artifactId>jakarta.persistence-api</artifactId>
        <version>3.1.0</version>
    </dependency>

    <!-- 4. JUnit Jupiter (JUnit 5) — библиотека для написания и запуска тестов LibraryTest -->
    <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>5.10.2</version>
        <scope>test</scope>
    </dependency>
</dependencies>

<build>
    <plugins>
        <!-- Плагин для корректного запуска JUnit 5 тестов через Maven команды (например, mvn test) -->
        <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.2.5</version>
        </plugin>
    </plugins>
</build>

</project>